# Copy to .dev.vars locally, or .dev.vars.staging / .dev.vars.production for the chosen deployment.
# Real files are ignored. Never put secret values in command arguments or chat.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated stable Google sub values, never emails. Mandatory in staging/production and for scheduled jobs; optional for local interactive OAuth.
ALLOWED_GOOGLE_SUBJECTS=
