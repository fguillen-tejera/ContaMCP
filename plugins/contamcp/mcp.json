      "type": "streamable-http",
      "url": "https://contamcp.devbyfer.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["ledger:read", "ledger:write"]
