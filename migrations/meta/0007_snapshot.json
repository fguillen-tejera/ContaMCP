      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "valid_recording_source": {
          "name": "valid_recording_source",
          "value": "\"expenses\".\"source\" IN ('user', 'recurring')"
        },
        "valid_payment_status": {
          "name": "valid_payment_status",
          "value": "\"expenses\".\"payment_status\" IN ('confirmed', 'unverified') AND (\"expenses\".\"payment_status\" = 'confirmed' OR (\"expenses\".\"source\" = 'recurring' AND \"expenses\".\"recurring_id\" IS NOT NULL))"
        },
        "valid_entry_type": {
          "name": "valid_entry_type",
          "value": "\"expenses\".\"type\" IN ('expense', 'income')"
        },
        "valid_occurrence": {
          "name": "valid_occurrence",
          "value": "(\"expenses\".\"recurring_id\" IS NULL AND \"expenses\".\"occurrence_date\" IS NULL) OR (\"expenses\".\"recurring_id\" IS NOT NULL AND \"expenses\".\"occurrence_date\" IS NOT NULL)"
        },
        "positive_exact_amount": {
          "name": "positive_exact_amount",
          "value": "typeof(\"expenses\".\"amount_minor\") = 'integer' AND \"expenses\".\"amount_minor\" BETWEEN 1 AND 999999999999"
        },
        "valid_currency": {
          "name": "valid_currency",
          "value": "\"expenses\".\"currency\" IN ('MXN', 'USD', 'EUR')"
        },
        "valid_description": {
          "name": "valid_description",
          "value": "length(trim(\"expenses\".\"description\")) BETWEEN 1 AND 500"
        },
        "positive_version": {
          "name": "positive_version",
          "value": "typeof(\"expenses\".\"version\") = 'integer' AND \"expenses\".\"version\" > 0"
        },
        "valid_category": {
          "name": "valid_category",
          "value": "\"expenses\".\"category\" IN ('food_drink', 'groceries', 'transport', 'shopping', 'entertainment', 'education', 'bills_services', 'health', 'home', 'pets', 'travel', 'other')"
        },
        "valid_date": {
          "name": "valid_date",
          "value": "\"expenses\".\"date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND \"expenses\".\"date\" BETWEEN '1900-01-01' AND '9999-12-31' AND date(\"expenses\".\"date\", '+0 days') IS NOT NULL AND date(\"expenses\".\"date\", '+0 days') = \"expenses\".\"date\""
        }
      }
    },
