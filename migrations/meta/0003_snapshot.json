      "checkConstraints": {
        "positive_exact_amount": {
          "name": "positive_exact_amount",
          "value": "typeof(\"expenses\".\"amount_minor\") = 'integer' AND \"expenses\".\"amount_minor\" BETWEEN 1 AND 999999999999"
        },
        "valid_currency": {
          "name": "valid_currency",
          "value": "\"expenses\".\"currency\" IN ('MXN', 'USD', 'EUR')"
        },
        "valid_description": {
          "name": "valid_description",
          "value": "length(trim(\"expenses\".\"description\")) BETWEEN 1 AND 500"
        },
        "positive_version": {
          "name": "positive_version",
          "value": "typeof(\"expenses\".\"version\") = 'integer' AND \"expenses\".\"version\" > 0"
        },
        "valid_category": {
          "name": "valid_category",
          "value": "\"expenses\".\"category\" IN ('food_drink', 'groceries', 'transport', 'shopping', 'entertainment', 'education', 'bills_services', 'health', 'home', 'pets', 'travel', 'other')"
        },
        "valid_date": {
          "name": "valid_date",
          "value": "\"expenses\".\"date\" GLOB '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]' AND \"expenses\".\"date\" BETWEEN '1900-01-01' AND '9999-12-31' AND date(\"expenses\".\"date\", '+0 days') IS NOT NULL AND date(\"expenses\".\"date\", '+0 days') = \"expenses\".\"date\""
        }
      }
