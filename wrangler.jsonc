{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contamcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "triggers": { "crons": ["0 * * * *"] },
  "vars": { "APP_ORIGIN": "http://localhost:8787", "APP_ENV": "local" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contamcp",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    {
      "name": "OAUTH_RATE_LIMIT",
      "namespace_id": "21001",
      "simple": { "limit": 20, "period": 60 }
    },
    { "name": "MCP_RATE_LIMIT", "namespace_id": "21002", "simple": { "limit": 120, "period": 60 } }
  ],
  "env": {
    "production": {
      "name": "contamcp-production",
      // Public template only: choose the hostname and provision isolated resources before deploying.
      "account_id": "00000000000000000000000000000000",
      "workers_dev": true,
      "preview_urls": false,
      // Enable the hourly job only after the production rollout gates in docs/production.md.
      "triggers": { "crons": [] },
      "vars": {
        "APP_ORIGIN": "https://contamcp-production.YOUR_SUBDOMAIN.workers.dev",
        "APP_ENV": "production",
        // Optional public ownership proof from the OpenAI submission portal; never an auth token.
        "OPENAI_APPS_CHALLENGE": "",
        "GOOGLE_ACCESS_MODE": "allowlist"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "contamcp-production",
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000002" }],
      "ratelimits": [
        {
          "name": "OAUTH_RATE_LIMIT",
          "namespace_id": "23001",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "MCP_RATE_LIMIT",
          "namespace_id": "23002",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    },
    "staging": {
      "name": "contamcp-staging",
      // Replace with your own Cloudflare account and provisioned resource IDs before deploying.
      "account_id": "00000000000000000000000000000000",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": ["0 * * * *"] },
      "vars": {
        "APP_ORIGIN": "https://contamcp-staging.YOUR_SUBDOMAIN.workers.dev",
        "APP_ENV": "staging",
        "GOOGLE_ACCESS_MODE": "allowlist"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "contamcp-staging",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000001" }],
      "ratelimits": [
        {
          "name": "OAUTH_RATE_LIMIT",
          "namespace_id": "22001",
          "simple": { "limit": 20, "period": 60 }
        },
        {
          "name": "MCP_RATE_LIMIT",
          "namespace_id": "22002",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "head_sampling_rate": 0.1 },
    // OAuth callback URLs contain authorization codes. Enable traces only after a redaction review.
    "traces": { "enabled": false }
  }
}
